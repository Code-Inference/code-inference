{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "opencode": {
      "name": "OpenCode Zen",
      "models": {
        "big-pickle": {
          "name": "Big Pickle"
        },
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash Free"
        },
        "mimo-v2.5-free": {
          "name": "MiMo-V2.5 Free"
        },
        "nemotron-3-ultra-free": {
          "name": "Nemotron 3 Ultra Free"
        }
      }
    },

    "code-inference": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Local Code Inference Server",
      "settings": {
        "baseURL": "http://api:8000/v1"
      },
      "models": {
        "model.gguf": {
          "name": "Local Model",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 16384,
            "output": 8192
          }
        }
      }
    },
    "code-inference-hf": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Local Code Inference Server",
      "settings": {
        "baseURL": "http://inference-hf:8081/v1"
      },
      "models": {
        "hf": {
          "name": "Local Model From HF"
        }
      }
    }

  },
  "model": "code-inference/model.gguf",
  "instructions": [
    "AGENTS.md"
  ]
}
