# Copy to .env and adjust. Used by docker compose.

# GGUF filename inside the model_data volume (see docs/models/README.md)
MODEL_FILENAME=model.gguf

# llama-server (CPU, small VM)
CONTEXT_SIZE=1024
MAX_TOKENS=256
THREADS=2

# API
INFERENCE_URL=http://inference:8080
RATE_LIMIT_PER_MINUTE=30
MAX_PROMPT_CHARS=8000

# Agent versions (optional; uncomment to pin). Omit to use each Dockerfile's ARG
# default. Values are substituted by compose as-is, so use the form each tool
# publishes: opencode image tags omit the `v` (2.0.30, not v2.0.30).
#OPENCODE_VERSION=2.0.30
#CLAUDE_CODE_VERSION=2.1.289
#CURSOR_VERSION=2026.10.01
#CODEX_VERSION=0.160.0
#GROK_VERSION=1.0.46
#HERMES_VERSION=0.19.0
#PI_VERSION=1.4.0
